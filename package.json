{
  "name": "personal-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "build:desktop": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.3.3",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  },
  "build": {
    "appId": "com.personal.workspace",
    "productName": "Personal Workspace",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
